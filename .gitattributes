# GitHub Actions: CRLF in `run: |` multiline breaks bash (`then\r` → swap never runs).
.github/**/*.yml text eol=lf
.github/**/*.yaml text eol=lf

# Shell must use LF only (bash fails on CRLF from Windows checkouts).
scripts/**/*.sh text eol=lf
scripts/lib/*.sh text eol=lf

# Go sources — LF for gofmt / CI verify on Linux.
*.go text eol=lf
.cursor/rules/*.mdc text eol=lf

# HAProxy golden fixtures + SPOE/IPBL snippets — LF only (Windows checkout + haproxy -c on Linux).
internal/haproxy/testdata/golden/** text eol=lf
