# GitHub Actions: CRLF in `run: |` multiline breaks bash (`then\r` → swap never runs).
.github/**/*.yml text eol=lf
.github/**/*.yaml text eol=lf

# Shell must use LF only (bash fails on CRLF from Windows checkouts).
scripts/**/*.sh text eol=lf
scripts/lib/*.sh text eol=lf
packaging/ovf/*.sh text eol=lf

# Debian maintainer scripts are extensionless POSIX shell files.
packaging/deb/* text eol=lf

# Go sources — LF for gofmt / CI verify on Linux.
*.go text eol=lf
# Embedded UI CSP hashes use browser-normalized script text on every OS.
internal/webui/dist/*.html text eol=lf
internal/webui/src/** text eol=lf
# Phase 1 preserves six legacy end-of-line spaces for a byte-identical bundle.
internal/webui/src/document-after-tokens.html whitespace=-trailing-space
.cursor/rules/*.mdc text eol=lf

# HAProxy golden fixtures + SPOE/IPBL snippets — LF only (Windows checkout + haproxy -c on Linux).
internal/haproxy/testdata/golden/** text eol=lf

# Physical LF carries continuation semantics in diagnostic env masking fixtures.
internal/diagnostics/testdata/environment-multiline*.example text eol=lf
