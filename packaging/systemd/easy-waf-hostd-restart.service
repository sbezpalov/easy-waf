[Unit]
Description=Easy Home WAF APT owner and broker restart after package transactions
# No dependency/ordering on either: ExecStart waits for synchronous restart jobs.
# This service has its own cgroup, outside the APT owner and broker.

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/sbin/easy-waf-hostd restart-after-packages
# Helper budget is 35 minutes; leave time for cancellation/process cleanup.
TimeoutStartSec=36min
# TERM cancels lock acquisition. Once a restart job is submitted, let its
# systemctl child finish the bounded wait before releasing package locks.
KillMode=mixed
TimeoutStopSec=3min
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
# Keep name replacements visible for the helper's final inode check. Per-file
# bind mounts would pin an old lock inode even after its host path is replaced.
ReadWritePaths=/var/lib/dpkg /var/lib/easy-waf-hostd
ProtectControlGroups=true
NoNewPrivileges=true
