[Unit]
Description=Easy Home WAF privileged host broker (root)
After=network.target
Before=easy-waf-api.service

[Service]
Type=simple
User=root
Group=easy-waf
RuntimeDirectory=easy-waf
RuntimeDirectoryMode=0750
ExecStart=/usr/sbin/easy-waf-hostd
# SSH key management (and userdel) is refused for root-equivalent accounts:
# members of root/sudo/admin/wheel/docker/lxd/incus-admin/libvirt/disk/
# easy-waf/haproxy, or accounts a sudoers rule names. Writing into such an
# account's authorized_keys turns a
# compromised easy-waf-api into root on this appliance. Uncomment only if you
# manage such an account's keys from the UI and accept that trade-off. The switch
# lives here, in a root-owned unit, precisely so easy-waf-api cannot flip it.
#Environment=EASY_WAF_HOSTD_ALLOW_PRIVILEGED_SSH_TARGETS=1
Restart=on-failure
RestartSec=2
# ProtectHome must stay false: the broker writes ~/.ssh/authorized_keys for
# managed accounts (PUT /host/users/{name}/ssh-keys), and ProtectHome=true makes
# /home appear empty to this service, so that endpoint silently cannot work.
# The keys path is guarded instead by broker-side validation, refusal of
# root-equivalent target accounts, and symlink-free openat2 writes.
ProtectHome=false
ProtectControlGroups=true
NoNewPrivileges=false
StateDirectory=easy-waf

[Install]
WantedBy=multi-user.target
