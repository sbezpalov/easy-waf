[Unit]
Description=Easy Home WAF API (control plane + UI; architecture C)
After=network-online.target postgresql.service easy-waf-hostd.service
Wants=network-online.target easy-waf-hostd.service
# Keep retrying when PostgreSQL comes up late (or is remote and briefly
# unreachable): with the default start limit, five quick failures left the
# control plane dead until someone noticed.
StartLimitIntervalSec=0

[Service]
Type=simple
User=easy-waf
Group=easy-waf
EnvironmentFile=-/etc/easy-waf/easy-waf.env
# Management UI: HTTP/HTTPS from EASY_WAF_LISTEN_* in easy-waf.env; state dir from EASY_WAF_STATE_DIR (default /var/lib/easy-waf in binary).
# Do not use ${VAR:-default} in ExecStart — some systemd builds pass it literally and ListenAndServe fails immediately (exit 1).
ExecStart=/usr/sbin/easy-waf-api
Restart=on-failure
RestartSec=5
# run.go stops listeners within 20s. Leave a little room, then give up.
TimeoutStopSec=30s
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# AF_UNIX is D-Bus (systemctl show) and the hostd socket. AF_INET/AF_INET6
# are PostgreSQL and the management listeners. No SystemCallFilter: the
# process still execs systemctl.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# /run covers D-Bus and systemd’s runtime dir so `systemctl show` from the dashboard can query other units.
ReadWritePaths=/var/lib/easy-waf /run
StateDirectory=easy-waf

[Install]
WantedBy=multi-user.target
