// Host management: allow easy-waf to control whitelisted systemd units (same set as host API).
polkit.addRule(function(action, subject) {
    if (subject.user != "easy-waf") {
        return;
    }
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var allowed = [
            "easy-waf-api.service",
            "easy-waf-acmed.service",
            "haproxy.service",
            "crowdsec.service",
            "crowdsec-spoa-bouncer.service",
            "fail2ban.service",
            "nftables.service",
            "postgresql.service"
        ];
        if (allowed.indexOf(unit) >= 0) {
            return polkit.Result.YES;
        }
    }
});
