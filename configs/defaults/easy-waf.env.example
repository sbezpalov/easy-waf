# Copy to /etc/easy-waf/easy-waf.env (Linux paths only — no Windows drive letters)
# Use a strong DB password; install-interactive.sh may rotate easywaf:secret / easywaf:easywaf when local PostgreSQL is installed.
DATABASE_URL=postgres://easywaf:secret@127.0.0.1:5432/easywaf?sslmode=disable
EASY_WAF_STATE_DIR=/var/lib/easy-waf
# Management UI: plain HTTP and HTTPS (TLS uses self-signed cert in EASY_WAF_STATE_DIR/secrets/management.{crt,key} until replaced in GUI).
EASY_WAF_LISTEN_HTTP=0.0.0.0:8000
EASY_WAF_LISTEN_HTTPS=0.0.0.0:8443
# EASY_WAF_MANAGEMENT_HTTPS=0   # omit TLS listener (HTTP only)
# Deprecated: EASY_WAF_LISTEN=... — use LISTEN_HTTP / LISTEN_HTTPS
# Optional: legacy automation Bearer (full API access). Prefer UI login (POST /api/v1/auth/login).
# EASY_WAF_ADMIN_TOKEN=
# JWT signing key (optional). If unset, a key is created at EASY_WAF_STATE_DIR/secrets/jwt.secret
# EASY_WAF_JWT_SECRET=
# EASY_WAF_DEV=1
EASY_WAF_SKIP_RELOAD=0
EASY_WAF_SKIP_VALIDATE=0
# Emergency: set to 1 to bypass management IP allowlist (lockout recovery; restart service)
# EASY_WAF_BYPASS_MGMT_ACL=0
# ACME worker (easy-waf-acmed)
# EASY_WAF_ACME_TICK=30s
# EASY_WAF_ACME_SKIP_APPLY=0
# Loopback HTTP for HAProxy bk_acme (HTTP-01 files under acme webroot). Default 127.0.0.1:8089; set 0 to disable.
# EASY_WAF_ACME_INTERNAL_HTTP=127.0.0.1:8089
CROWDSEC_LAPI_URL=http://127.0.0.1:8080
# CROWDSEC_LAPI_KEY=
# --- nftables host firewall (scripts/install.sh; not required by easy-waf-api process) ---
# EASY_WAF_NFT_EDGE=1               # 0 = do not open tcp/80+443 on the appliance
# EASY_WAF_NFT_MGMT_LAN=1          # 0 = do not restrict management ports to RFC1918
# EASY_WAF_NFT_MGMT_PORTS="8000 8443"
# EASY_WAF_EXTRA_LAN_CIDR=         # optional extra source CIDR for management ports
