# Copy to /etc/easy-waf/easy-waf.env (Linux paths only — no Windows drive letters)
# Use a strong DB password; install-interactive.sh may rotate easywaf:secret / easywaf:easywaf when local PostgreSQL is installed.
DATABASE_URL=postgres://easywaf:secret@127.0.0.1:5432/easywaf?sslmode=disable
EASY_WAF_STATE_DIR=/var/lib/easy-waf
# Management UI: HTTPS is the default listener (self-signed cert in EASY_WAF_STATE_DIR/secrets/management.{crt,key} until replaced in GUI).
# Cleartext management HTTP is off by default. Loopback HTTP is allowed without a flag.
# EASY_WAF_LISTEN_HTTP=off
# EASY_WAF_LISTEN_HTTP=127.0.0.1:8000
# Non-loopback cleartext (discouraged) also requires:
# EASY_WAF_ALLOW_INSECURE_HTTP=1
# EASY_WAF_LISTEN_HTTP=0.0.0.0:8000
EASY_WAF_LISTEN_HTTPS=0.0.0.0:8443
# EASY_WAF_MANAGEMENT_HTTPS=0   # omit TLS listener (then set loopback HTTP or the process refuses to start)
# Deprecated: EASY_WAF_LISTEN=... — use LISTEN_HTTP / LISTEN_HTTPS
# Optional: legacy automation Bearer (full API access). Prefer UI login (POST /api/v1/auth/login).
# EASY_WAF_ADMIN_TOKEN=
# JWT signing key (optional, minimum 32 characters). Leave unset unless several
# appliances must share sessions: a 32-byte random key is then created at
# EASY_WAF_STATE_DIR/secrets/jwt.secret (mode 0600). A value shorter than the
# minimum stops easy-waf-api at startup with an explicit message.
# EASY_WAF_JWT_SECRET=
# Lab escape hatches. Leave both commented out on a real appliance: the first
# stops HAProxy being reloaded after an apply, the second stops the generated
# config being checked with `haproxy -c` first. Values are read as booleans, so
# 0/false/off mean "do not skip" — but an appliance that does not need them
# should not carry them at all.
# EASY_WAF_SKIP_RELOAD=1
# EASY_WAF_SKIP_VALIDATE=1
# Emergency: set to 1 to bypass management IP allowlist (lockout recovery; restart service)
# EASY_WAF_BYPASS_MGMT_ACL=0
# ACME worker (easy-waf-acmed)
# EASY_WAF_ACME_TICK=30s
# EASY_WAF_ACME_SKIP_APPLY=0
# Loopback HTTP for HAProxy bk_acme (HTTP-01 files under acme webroot). Independent of management HTTP. Default 127.0.0.1:8089; set 0 to disable.
# EASY_WAF_ACME_INTERNAL_HTTP=127.0.0.1:8089
CROWDSEC_LAPI_URL=http://127.0.0.1:8080
# Extra CrowdSec LAPI origins (comma-separated). Default allowlist is loopback :8080 only.
# CROWDSEC_LAPI_ALLOWED_ORIGINS=https://crowdsec.example.test:8443
# CROWDSEC_LAPI_KEY=
# --- nftables host firewall (scripts/install.sh; not required by easy-waf-api process) ---
# EASY_WAF_NFT_EDGE=1               # 0 = do not open tcp/80+443 on the appliance
# EASY_WAF_NFT_MGMT_LAN=1          # 0 = do not restrict management ports to RFC1918
# EASY_WAF_NFT_MGMT_PORTS="8000 8443"
# EASY_WAF_EXTRA_LAN_CIDR=         # optional extra source CIDR for management ports
