# Optional: terminate TLS for the management UI on LAN using NGINX, proxying to easy-wafd on loopback.
# HAProxy remains the public 80/443 edge.

server {
    listen 8443 ssl;
    server_name appliance.lan;
    ssl_certificate     /etc/easy-waf/ui/fullchain.pem;
    ssl_certificate_key /etc/easy-waf/ui/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
