# Legacy / reference SPOE — HAProxy 2.8+ expects a [engine] scope matching `filter spoe engine …`,
# `spoe-message` (not `message`), and the `use-backend` target as a normal `backend` in haproxy.cfg.
# Production installs use the vendor file, e.g. /etc/haproxy/crowdsec.cfg (crowdsec-haproxy-spoa-bouncer; see docs/CROWDSEC.md).

[crowdsec]

spoe-agent crowdsec
	messages crowdsec
	option var-prefix crowdsec
	timeout hello 100ms
	timeout idle 30s
	timeout processing 5s
	use-backend crowdsec-socket
	log global

spoe-message crowdsec
	args src
	event on-frontend-http-request
